{"inkVersion":21,"root":[[["done",{"#f":5,"#n":"g-0"}],null],"done",{"tutodebut":["^Junior, approche-toi s'il te plait.","\n","#","^speaker:Socrate ","/#","#","^portrait:Socrate","/#","^Bien Père ! ","#","^speaker:Junior ","/#","#","^portrait:Junior","/#","\n",{"->":"tutomarche"},"end",{"#f":1}],"tutomarche":["ev",{"VAR?":"gamepad"},"/ev",[{"->":".^.b","c":true},{"b":["\n","^Pour bouger, utilise le joystick gauche ","#","^speaker: Simone ","/#","#","^portrait: Simone","/#","\n",{"->":".^.^.^.5"},null]}],[{"->":".^.b"},{"b":["\n","^Pour bouger, utilise les touches ZQSD ou les flêches ","#","^speaker: Simone ","/#","#","^portrait: Simone","/#","\n",{"->":".^.^.^.5"},null]}],"nop","\n","end",{"#f":1}],"tutocarte":["ev",true,"/ev",{"VAR=":"tutomarche_completed","re":true},"^Nous, Castors, vivons la nuit.","\n","^Si nous avons une mauvaise vue, nous la compensons par d'autres sens bien plus développés comme le toucher et l'odorat, et une grande connaissance de notre environnement.","\n","ev",true,"/ev",{"VAR=":"carte","re":true},"^C'est comme une carte mentale qui ressemblerait à ça.","\n","^Approche-toi, regarde ces points lumineux.","\n","ev",true,"/ev",{"VAR=":"tutocarte_completed","re":true},"end",{"#f":1}],"tutohalo":["^Les verts indiquent les herbes, les tons jaunes, les arbres, dont nous reconnaissons les différentes essences.","\n","^Mère, Pére, que se passe-t-il ?","\n","^Junior, dans le jeu comme dans la vie, il y a des priorités. ","#","^portrait: Socrate ","/#","#","^speaker: Socrate","/#","\n","^Le halo qui t'entoure est une aide pour te déplacer dans le noir, il signale aussi ton humeur.  ","#","^portrait: Simone ","/#","#","^speaker: Simone","/#","\n","^En vert, tout va bien, en jaune : il fait faim !  ","#","^portrait: Socrate ","/#","#","^speaker: Socrate","/#","\n","^Tu en découvriras d'autres lors de tes explorations","\n","^Junior, sortons bouloter ! ","#","^portrait: Simone ","/#","#","^speaker: Simone","/#","\n","ev",true,"/ev",{"VAR=":"tutohalo_completed","re":true},"end",{"#f":1}],"tutonage":["ev",{"VAR?":"gamepad"},"/ev",[{"->":".^.b","c":true},{"b":["\n","^Pour faire surface ou plonger, clique B ","#","^speaker: Simone ","/#","#","^portrait: Simone","/#","\n",{"->":".^.^.^.5"},null]}],[{"->":".^.b"},{"b":["\n","^Pour faire surface ou plonger, clique E ","#","^speaker: Simone ","/#","#","^portrait: Simone","/#","\n",{"->":".^.^.^.5"},null]}],"nop","\n","ev",true,"/ev",{"VAR=":"tutonage_completed","re":true},"end",{"#f":1}],"tutomange":["^Par ici, la salade est de saison ","#","^speaker: Simone ","/#","#","^portrait: Simone","/#","\n","ev",{"VAR?":"gamepad"},"/ev",[{"->":".^.b","c":true},{"b":["\n","^Goûte, clique X ","#","^speaker: Simone ","/#","#","^portrait: Simone","/#","\n",{"->":".^.^.^.13"},null]}],[{"->":".^.b"},{"b":["\n","^Goûte, clique F ","#","^speaker: Simone ","/#","#","^portrait: Simone","/#","\n",{"->":".^.^.^.13"},null]}],"nop","\n","ev",true,"/ev",{"VAR=":"tutomange_completed","re":true},"end",{"#f":1}],"tutofin":["^Hâtons nous vers le terrier.","\n","^Regarde le cadran en haut a gauche, le soleil se lève bientôt.","\n","^Demain sera une grande nuit pour le peuple castor !","\n","end",{"#f":1}],"global decl":["ev",false,{"VAR=":"marcher_completed"},true,{"VAR=":"gamepad"},false,{"VAR=":"carte"},false,{"VAR=":"tutomarche_completed"},false,{"VAR=":"tutocarte_completed"},false,{"VAR=":"tutonage_completed"},false,{"VAR=":"tutomange_completed"},false,{"VAR=":"tutohalo_completed"},"/ev","end",null],"#f":1}],"listDefs":{}}